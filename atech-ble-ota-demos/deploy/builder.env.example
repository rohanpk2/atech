# /etc/atech/builder.env : environment for the Atech builder container (read by compose env_file).
# Keep it root-only (chmod 600). Nothing here is copied into the image.

# Required. The backend uses the official Anthropic SDK; the `claude` CLI fallback is not in the image.
ANTHROPIC_API_KEY=

# Recommended once the service is reachable by anyone but you: a fixed dashboard key. Every /api/*
# request must carry it (header x-atech-key, ?key= or the cookie the dashboard sets from a ?key= link).
# Leave unset and the entrypoint generates one on first start and keeps it in the builds volume.
# ATECH_BUILDER_KEY=

# Optional, defaults shown.
# ATECH_LLM_MODEL=claude-opus-5-5
# ATECH_LLM_PROVIDER=anthropic
# ATECH_MAX_REPAIRS=3
# ATECH_PIO_JOBS=1                  # parallel compile jobs; the image defaults to 1 for 2 GB of RAM.
#                                   # Keep it commented out rather than blank: a blank value removes the limit.
# ATECH_LAN_PORT=8080
# ATECH_LAN_CHUNK_BYTES=131072
# ATECH_SIMULATED_DEVICE=           # "1", "2" or "all": simulated boards for demos without hardware (they also
#                                   # register through the cloud API, so the hosted dashboard shows them)

# Cloud Wi-Fi OTA (boards pull firmware from this server; see CLOUD_WIFI_OTA.md).
# Required for cloud deployments: the public https origin of this server (the Caddy name from caddy.env).
# It is baked into every generated image and the USB baseline as the server the board reports to.
# ATECH_PUBLIC_URL=https://atech-api.example.com
# Optional timings, defaults shown.
# ATECH_CLOUD_POLL_MS=15000           # how often a board polls
# ATECH_CLOUD_JOB_TTL_MIN=30          # a pending job expires after this
# ATECH_CLOUD_STALL_S=120             # a download with no progress report for this long fails
# ATECH_CLOUD_REBOOT_TIMEOUT_S=300    # a board that does not come back after its reboot fails the job
# ATECH_CLOUD_CONFIRM_TIMEOUT_S=120   # a board that came back but never confirmed fails the job
# ATECH_CLOUD_OFFLINE_S=45            # a board unseen for this long is shown offline
# ATECH_CLOUD_MAX_ATTEMPTS=5          # download resumptions per job
# ATECH_CLOUD_CHUNK_BYTES=131072      # ranged download chunk offered to the board

# Set by compose.yaml and not overridable here: ATECH_BUILDER_HOST=0.0.0.0, ATECH_BUILDER_PORT=5173,
# ATECH_BUILDS_DIR=/data/builds, PLATFORMIO_CORE_DIR, PLATFORMIO_BIN.
