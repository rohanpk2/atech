# /etc/atech/builder.env : environment for the Atech builder container (read by compose env_file).
# Keep it root-only (chmod 600). Nothing here is copied into the image.

# Required. The backend uses the official Anthropic SDK; the `claude` CLI fallback is not in the image.
ANTHROPIC_API_KEY=

# Recommended once the service is reachable by anyone but you: a fixed dashboard key. Every /api/*
# request must carry it (header x-atech-key, ?key= or the cookie the dashboard sets from a ?key= link).
# Leave unset and the entrypoint generates one on first start and keeps it in the builds volume.
# ATECH_BUILDER_KEY=

# Optional, defaults shown.
# ATECH_LLM_MODEL=claude-opus-5-5
# ATECH_LLM_PROVIDER=anthropic
# ATECH_MAX_REPAIRS=3
# ATECH_PIO_JOBS=1                  # parallel compile jobs; the image defaults to 1 for 2 GB of RAM.
#                                   # Keep it commented out rather than blank: a blank value removes the limit.
# ATECH_LAN_PORT=8080
# ATECH_LAN_CHUNK_BYTES=131072
# ATECH_SIMULATED_DEVICE=           # "1", "2" or "all": simulated boards for demos without hardware

# Set by compose.yaml and not overridable here: ATECH_BUILDER_HOST=0.0.0.0, ATECH_BUILDER_PORT=5173,
# ATECH_BUILDS_DIR=/data/builds, PLATFORMIO_CORE_DIR, PLATFORMIO_BIN.
