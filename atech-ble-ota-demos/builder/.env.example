# Atech AI firmware builder - backend-only settings template.
# Copy to builder/.env (git-ignored) and fill in the key. `npm start` loads builder/.env; variables
# already set in the shell win over the file, and a blank value counts as unset.

# Anthropic API key (https://console.anthropic.com/settings/keys). With a key set the backend uses the
# official SDK; left blank it falls back to the logged-in `claude` CLI. Never commit the real key.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown).
# ATECH_LLM_PROVIDER=anthropic        # anthropic | claude-cli (auto-detected when unset)
# ATECH_LLM_MODEL=claude-opus-5-5
# ATECH_MAX_REPAIRS=3
# ATECH_BUILDER_PORT=5173
# ATECH_BUILDER_HOST=127.0.0.1
# ATECH_BUILDS_DIR=../.ai-builds
# PLATFORMIO_BIN=~/.platformio/penv/bin/pio
# PLATFORMIO_CORE_DIR=~/.platformio    # where PlatformIO keeps penv/, packages/ (boot_app0.bin for the USB installer)
# ATECH_PIO_JOBS=                     # parallel compile jobs for `pio run`; unset = CPU count, 1 on small servers

# Wi-Fi deployment (LAN OTA) settings, defaults shown.
# ATECH_LAN_PORT=8080                 # port of the board's LAN OTA service (mDNS _atech-ota._tcp)
# ATECH_LAN_CHUNK_BYTES=131072        # bytes per authenticated PUT during a transfer
# ATECH_BUILDER_KEY=                  # dashboard key; generated automatically when --host is not loopback
# ATECH_SIMULATED_DEVICE=             # "1", "2" or "all": start simulated boards in-process (no hardware); they also
#                                     # poll this backend's cloud API, so Cloud Wi-Fi deploy can be tried locally

# Cloud Wi-Fi OTA (see CLOUD_WIFI_OTA.md). The public origin boards report to; baked into generated firmware.
# A plain http:// value only works with firmware compiled with -DATECH_CLOUD_ALLOW_HTTP=1 (lab use).
# ATECH_PUBLIC_URL=https://atech-api.example.com
# ATECH_CLOUD_POLL_MS=15000
# ATECH_CLOUD_JOB_TTL_MIN=30
# ATECH_CLOUD_STALL_S=120
# ATECH_CLOUD_REBOOT_TIMEOUT_S=300
# ATECH_CLOUD_CONFIRM_TIMEOUT_S=120
# ATECH_CLOUD_OFFLINE_S=45
# ATECH_CLOUD_MAX_ATTEMPTS=5
# ATECH_CLOUD_CHUNK_BYTES=131072
